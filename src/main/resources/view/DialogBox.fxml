<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns:fx="http://javafx.com/fxml" alignment="TOP_RIGHT" spacing="10.0">
    <children>
        <Label fx:id="dialog" text="Label" wrapText="true" maxWidth="325.0" />
        <ImageView fx:id="displayPicture" fitHeight="50.0" fitWidth="50.0" preserveRatio="true" />
    </children>
    <padding>
        <Insets top="5.0" bottom="5.0" left="5.0" right="5.0" />
    </padding>
</HBox>
