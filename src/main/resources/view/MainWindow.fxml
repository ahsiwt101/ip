<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="milo.gui.MainWindow"
            prefHeight="600.0" prefWidth="400.0" minHeight="600.0" minWidth="400.0">
    <children>
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" vbarPolicy="ALWAYS" fitToWidth="true"
                    prefHeight="530.0" prefWidth="400.0"
                    AnchorPane.topAnchor="1.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="480.0" prefWidth="380.0" spacing="10.0">
                    <padding>
                        <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" prefHeight="41.0" prefWidth="324.0" onAction="#handleUserInput"
                   AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0" />
        <Button fx:id="sendButton" text="Send" prefHeight="41.0" prefWidth="76.0" onAction="#handleUserInput"
                AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0" />
    </children>
</AnchorPane>
